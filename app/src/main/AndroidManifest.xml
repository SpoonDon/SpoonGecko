<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Android 17+ (targetSdk 37): without this runtime permission ("Nearby devices")
        the OS blocks every connection to the user's own network - router, modem,
        NAS, 192.168.x.x / 10.x.x.x, ISP gateways in 100.64.x.x. It is only asked for
        when such an address is actually opened. Unknown (and ignored) on older Android.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        Background playback: a foreground "media playback" service keeps audio/video
        playing (with notification controls) while the app is not on screen. The wake
        lock is held only while something is actually playing.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads: keeps a transfer running while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.provider.MediaStore.RECORD_SOUND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="video/*" />
        </intent>
        <package android:name="com.android.providers.downloads" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.documentsui" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="SpoonGecko"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SpoonGecko">

        <!--
            [PERF] configChanges: split-screen / freeform resizing and fold/unfold
            also change smallestScreenSize and screenLayout, and attaching a
            hardware keyboard changes keyboard/navigation. Without these flags
            Android destroyed and re-created the activity (closing and reloading
            every tab) for each of those events. The layout already adapts in
            place for orientation/screenSize, so nothing else needs to change.
            uiMode, density, fontScale, locale and layoutDirection are
            deliberately NOT handled: those still recreate the activity as before.

            [DEFAULT] launchMode singleTask: a link opened from another app is delivered to
            the browser that is already running (MainActivity.onNewIntent) instead of
            starting a second MainActivity, which would restore the same tabs again next
            to the first one. The launcher icon and the media notification still just
            bring the existing browser to the front.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                [DEFAULT] This is what makes Android list the app as a web browser: an
                activity that can open http and https links. It makes the app selectable
                under Settings > Apps > Default apps > Browser app, and offered in the
                "Open with" list for links. (MainActivity only ever loads http and https
                from such an intent, see MainActivity.linkFromIntent.)
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- [DEFAULT] Marks the app as a browser for "open the browser" requests. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity>

        <!--
            [WINDOW] A further browser window ("New window"): the same screen as MainActivity,
            started by the app itself in a task of its own (see MainActivity.openNewWindow), as
            many times as the user likes. Normal launch mode on purpose: unlike MainActivity it
            is not singleTask, so every launch is a new window. Not exported: only the app opens it.
            The configChanges are the same as MainActivity's, because it runs the same code.
        -->
        <activity
            android:name=".BrowserWindowActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout" />

        <!-- Extensions management screen (install / update / toggle / backup / restore) -->
        <activity
            android:name=".ExtensionsActivity"
            android:exported="false"
            android:label="Extensions"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- In-app Downloads Manager -->
        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:label="Downloads"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Consolidated Browser Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- [UPLOAD] Serves temporary capture output URIs for web <input type=file capture>. -->
        <provider
            android:name=".UploadFileProvider"
            android:authorities="${applicationId}.uploads"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Keeps media playing in the background; started only while something plays. -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps file downloads running in the background; started only while a download is active. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
