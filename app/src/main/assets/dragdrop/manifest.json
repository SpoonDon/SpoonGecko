{
  "manifest_version": 2,
  "name": "SpoonGecko Drop Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "dragdrop@spoongecko.internal"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
