{
  "manifest_version": 2,
  "name": "Vault AutoSave",
  "version": "1.0",
  "description": "Captures login form submissions for native vault storage",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vault-autosave@spoongecko.app"
    }
  }
}
