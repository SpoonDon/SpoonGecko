{
  "manifest_version": 2,
  "name": "SpoonGecko Scroll Reporter",
  "version": "1.0",
  "description": "Internal scroll-position reporter for pull-to-refresh.",
  "hidden": true,
  "browser_specific_settings": {
    "gecko": {
      "id": "scroll@spoongecko.browser",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scroll.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
