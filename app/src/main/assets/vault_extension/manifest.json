{
  "manifest_version": 2,
  "name": "SpoonGecko Vault Autosave",
  "version": "1.0",
  "description": "Prompts to save login credentials on form submission.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vault@spoongecko.app"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vault_autosave.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons"
  ]
}
