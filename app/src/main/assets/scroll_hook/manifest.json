{
  "manifest_version": 2,
  "name": "SpoonGecko Scroll Hook",
  "version": "1.0",
  "description": "Reports whether the deepest scrollable ancestor is at the top.",
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    }
  ]
}
