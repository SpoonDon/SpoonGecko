<?xml version="1.0" encoding="utf-8"?>
<!--
  [F13] Fixed adaptive launcher icon.

  The previous file used the full-bleed legacy @mipmap/ic_launcher PNG as BOTH
  the foreground and the monochrome layer, so launchers cropped and zoomed it
  inside the adaptive mask. The dedicated layer PNGs
  (ic_launcher_background / ic_launcher_foreground / ic_launcher_monochrome)
  do exist in every mipmap-*dpi folder — the old comment claiming otherwise
  was stale — so they are referenced directly here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
