<?xml version="1.0" encoding="utf-8"?>
<!-- [TRANSLATE] Searchable list of languages. The dialog is given a fixed height in code,
     so the list takes the space that is left. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:padding="16dp">

    <TextView
        android:id="@+id/lp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <EditText
        android:id="@+id/lp_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Search languages"
        android:textColorHint="#66FFFFFF"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_glass_input"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no" />

    <ListView
        android:id="@+id/lp_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/lp_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone"
        android:text="No matching languages"
        android:textColor="#66FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/lp_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Close"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:background="@drawable/bg_glass_button"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
