<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_ext_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_glass_button"
            android:scaleType="centerInside"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Extensions"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_ext_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_glass_button"
            android:scaleType="centerInside"
            android:contentDescription="Add extension" />
    </LinearLayout>

    <!-- Quick actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_ext_check"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="Check updates"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_ext_backup"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="Backup"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_ext_restore"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="Restore"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_ext_auto"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Auto-update: ON"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Installed extensions -->
    <ListView
        android:id="@+id/ext_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#22FFFFFF"
        android:dividerHeight="1dp"
        android:clipToPadding="true"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/ext_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No extensions installed.\nTap + to add one from addons.mozilla.org"
        android:textColor="#66FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
