<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_theme_surface"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_back"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="@string/cd_back"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_forward"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_forward"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="@string/cd_forward"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_refresh"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="@string/cd_reload" />

            <AutoCompleteTextView
                android:id="@+id/url_bar"
                android:selectAllOnFocus="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/url_bar_background"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:hint="@string/url_bar_hint"
                android:textColor="@color/md_theme_on_surface"
                android:textColorHint="@color/md_theme_on_surface_variant"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:importantForAutofill="no"
                android:completionThreshold="1"
                android:dropDownHeight="240dp" />

            <TextView
                android:id="@+id/tab_manager"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="1/1"
                android:textColor="@color/md_theme_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_tab_manager" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="24dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="@string/cd_menu" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:progressTint="@color/md_theme_primary"
            android:progressBackgroundTint="@color/md_theme_surface_variant"
            android:visibility="gone" />

    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/md_theme_surface" />

</LinearLayout>
