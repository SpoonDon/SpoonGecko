<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_theme_surface"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp">

            <EditText
                android:id="@+id/url_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/url_bar_background"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:hint="Search or enter address"
                android:textColor="@color/md_theme_on_surface"
                android:textColorHint="@color/md_theme_on_surface_variant"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:importantForAutofill="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@android:drawable/ic_menu_search"
                app:iconSize="24dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                app:cornerRadius="24dp"
                app:strokeColor="@color/md_theme_surface_variant"
                app:strokeWidth="1dp"
                android:contentDescription="Go" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_back"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="Back"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_forward"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_forward"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="Forward"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_refresh"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="Refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_stop"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="Stop"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="24dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                android:contentDescription="Menu" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="@color/md_theme_primary"
            android:progressBackgroundTint="@color/md_theme_surface_variant"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tabMode="scrollable"
                app:tabIndicatorColor="@color/md_theme_primary"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="@color/md_theme_primary"
                app:tabTextColor="@color/md_theme_on_surface_variant"
                app:tabRippleColor="@color/md_theme_primary_container"
                app:tabMinWidth="72dp"
                app:tabMaxWidth="160dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_tab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@drawable/ic_add"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_primary"
                android:contentDescription="New tab" />
        </LinearLayout>
    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
