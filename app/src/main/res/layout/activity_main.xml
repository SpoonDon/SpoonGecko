<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/url_bar_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_glass_url_bar">

        <!-- Tab Manager Button (Left) -->
        <FrameLayout
            android:id="@+id/tab_button"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tab_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1/1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/forward_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_forward"
            android:background="@drawable/bg_glass_button"
            android:layout_marginEnd="6dp"
            android:scaleType="centerInside"
            android:contentDescription="Forward" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Enter address"
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_glass_input"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:selectAllOnFocus="true" />

        <!-- Menu Button -->
        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_menu"
            android:background="@drawable/bg_glass_button"
            android:layout_marginStart="6dp"
            android:scaleType="centerInside"
            android:contentDescription="Menu" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000" />
<!-- Solid Black Home Panel (Full Screen) -->
<LinearLayout
    android:id="@+id/home_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FF000000"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">

    <TextView
        android:id="@+id/logo_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SpoonGecko"
        android:textColor="#B3FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="22dp" />

    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Search with Brave"
        android:textColorHint="#66FFFFFF"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_glass_search"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no" />
</LinearLayout>

        <!-- Polished Suggestions List -->
        <ListView
            android:id="@+id/suggestions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:maxHeight="300dp"
            android:background="#FF111111"
            android:visibility="gone"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:clipToPadding="true" />
    </FrameLayout>
</LinearLayout>
