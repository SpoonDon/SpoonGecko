<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/md_theme_surface"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/url_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/url_bar_background"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:hint="Search or enter address"
                android:textColor="@color/md_theme_on_surface"
                android:textColorHint="@color/md_theme_on_surface_variant"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:singleLine="true"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:importantForAutofill="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.Material3.Button.IconButton"
                app:icon="@android:drawable/ic_menu_search"
                app:iconSize="24dp"
                app:iconTint="@color/md_theme_on_surface_variant"
                app:cornerRadius="24dp"
                app:strokeColor="@color/md_theme_surface_variant"
                app:strokeWidth="1dp"
                android:contentDescription="Go" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressTint="@color/md_theme_primary"
            android:progressBackgroundTint="@color/md_theme_surface_variant"
            android:visibility="gone" />

    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
