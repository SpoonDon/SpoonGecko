<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:fitsSystemWindows="false">

    <!-- Top URL bar: [ forward ] [ url ] [ menu ] -->
    <LinearLayout
        android:id="@+id/url_bar_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_glass_url_bar">

        <TextView
            android:id="@+id/forward_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="›"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Forward" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Enter address"
            android:textColorHint="#66FFFFFF"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_glass_input"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:selectAllOnFocus="true" />

        <TextView
            android:id="@+id/menu_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="⋮"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Content: GeckoView + home overlay -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000" />

        <LinearLayout
            android:id="@+id/home_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpoonGecko"
                android:textColor="#B3FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="22dp" />

            <EditText
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Search with Brave"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_glass_search"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:singleLine="true"
                android:importantForAutofill="no" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
