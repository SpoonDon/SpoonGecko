<?xml version="1.0" encoding="utf-8"?>
<!-- [TRANSLATE] The translate dialog: languages, the action, and the rules. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:padding="6dp"
    android:clipToOutline="true">

    <ScrollView
        android:id="@+id/tr_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <TextView
            android:id="@+id/tr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translate"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tr_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/tr_page_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tr_from"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tr_to"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tr_action"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tr_rule_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:paddingTop="20dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/tr_rule_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tr_rule_ask"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="Ask"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tr_rule_always"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="Always"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tr_rule_never"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="Never"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tr_site_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tr_site_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Never translate this site"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tr_site_toggle"
                    android:layout_width="72dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Offer to translate pages"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tr_offers_toggle"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tr_target_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tr_rules"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Language rules…"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tr_close"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
